# Copy to .env and fill in what you want to use. Everything is optional.

# Push to your phone: install the ntfy app and subscribe to a hard-to-guess topic name
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# E-mail (port 465 = SSL, anything else = STARTTLS)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Link used when you tap a test notification (optional)
PUBLIC_URL=http://localhost:8765
